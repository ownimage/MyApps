/.idea
node_modules/
/test-results/
/playwright-report/

/coverage-report/
/screenshots/
/temp/

# Python artefacts (the MyHID server tests): coverage.py data files and
# pytest's cache, if a run is ever started without redirecting them.
.coverage
.coverage.*
.pytest_cache/
htmlcov/
/MyHID/server/coverage.txt

# Python bytecode (the Blender add-on test imports the add-on by path).
__pycache__/
*.pyc

# MyHID server TLS certs (generated locally by --gen-cert: a local CA +
# the server leaf). NEVER commit the private keys.
/MyHID/server/*.crt
/MyHID/server/*.key
